                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="Foreground" Value="#FF475569"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,7,0"/>
                                </Style>
                                <Style x:Key="EdlFieldLabelStyle" TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#FF475569"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="EdlTextBoxStyle"
                                       TargetType="{x:Type TextBox}"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="Foreground" Value="#FF334155"/>
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#FFDDE2EA"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                                <Style x:Key="EdlComboBoxStyle"
                                       TargetType="{x:Type ComboBox}"
                                       BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#FF334155"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Background" Value="#FFF5F3F8"/>
                                    <Setter Property="Foreground" Value="#FF475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#FFE7E9EF"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Right Column: Log & Options -->
                            <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="130" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <GroupBox
                                Grid.Row="1"
                                Header="日志"
                                Style="{StaticResource EdlCardGroupBoxStyle}"
                                Padding="0,10,0,0"
                                Margin="0,8,0,0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                                    <Grid Background="#FFFAFBFD">
                                        <RichTextBox
                                        x:Name="EdlLogTextBox"
                                        IsReadOnly="True"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        FontFamily="Cascadia Mono,Microsoft YaHei UI,Consolas"
                                        FontSize="11.75"
                                        FontWeight="Normal"
                                        Foreground="#FF334155"
                                        Padding="7,7"
                                        Margin="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Background="#FFFAFBFD"
                                        BorderThickness="0">
                                            <FlowDocument PagePadding="0"
                                                          ColumnWidth="10000"
                                                          ColumnGap="0"
                                                          TextAlignment="Left"
                                                          LineHeight="19" />
                                        </RichTextBox>
                                    </Grid>
                                </GroupBox>

                                <GroupBox
                                    Grid.Row="0"
                                    Header="扩展功能"
                                    Style="{StaticResource EdlCardGroupBoxStyle}"
                                    Margin="0">
                                    <Viewbox Stretch="Uniform"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top">
                                        <Canvas Margin="0"
                                            Width="296"
                                            Height="94">
                                            <Button
                                            x:Name="EdlFactoryResetButton"
                                            Canvas.Left="0"
                                            Canvas.Top="0"
                                            Content="恢复出厂设置"
                                            Click="EdlFactoryResetButton_Click"
                                            Style="{StaticResource EdlSecondaryButtonStyle}"
                                            Width="94"
                                            Height="32"/>
                                            <Button
                                            x:Name="EdlWriteGptButton"
                                            Canvas.Left="106"
                                            Canvas.Top="0"
                                            Content="写入GPT"
                                            Click="EdlWriteGptButton_Click"
                                            Style="{StaticResource EdlSecondaryButtonStyle}"
                                            Width="94"
                                            Height="32" HorizontalAlignment="Left"/>
                                            <Button
                                            x:Name="EdlFormatLunButton"
                                            Canvas.Left="211"
                                            Canvas.Top="0"
                                            Content="格式化LUN"
                                            Click="EdlFormatLunButton_Click"
                                            Style="{StaticResource EdlDangerButtonStyle}"
                                            Width="94"
                                            Height="32" Foreground="#FF475569" BorderBrush="#FFD8DEE8" HorizontalAlignment="Left"/>
                                            <Button
                                            x:Name="EdlBackupModemFingerprintButton"
                                            Canvas.Left="0"
                                            Canvas.Top="38"
                                            Content="备份基带指纹"
                                            Click="EdlBackupModemFingerprintButton_Click"
                                            Style="{StaticResource EdlSecondaryButtonStyle}"
                                            Width="94"
                                            Height="32" VerticalAlignment="Top"/>
                                            <Button
                                            x:Name="EdlBackupGptButton"
                                            Canvas.Left="107"
                                            Canvas.Top="39"
                                            Content="备份GPT"
                                            Click="EdlBackupGptButton_Click"
                                            Style="{StaticResource EdlSecondaryButtonStyle}"
                                            Width="94"
                                            Height="32" HorizontalAlignment="Left"/>
                                            <Button
                                            x:Name="EdlForceOemButton"
                                            Canvas.Left="211"
                                            Canvas.Top="40"
                                            Content="强开OEM"
                                            Click="EdlForceOemButton_Click"
                                            Style="{StaticResource EdlSecondaryButtonStyle}"
                                            Width="94"
                                            Height="32" HorizontalAlignment="Left"/>
                                            <Button
                                            x:Name="EdlSlotManagementButton"
                                            Canvas.Top="76"
                                            Content="槽位管理"
                                            Click="EdlSlotManagementButton_Click"
                                            Style="{StaticResource EdlSecondaryButtonStyle}"
                                            Width="94"
                                            Height="32" VerticalAlignment="Top"/>
                                            <Button
                                            x:Name="EdlReadVersionInfoButton"
                                            Content="读版本信息"
                                            Canvas.Left="108"
                                            Canvas.Top="76"
                                            Width="94"
                                            Height="32"
                                            Style="{StaticResource EdlSecondaryButtonStyle}"
                                            Click="EdlReadVersionInfoButton_Click" HorizontalAlignment="Left"/>
                                            <Button
                                            x:Name="EdlBugFeedbackButton"
                                            Content="BUG反馈"
                                            Canvas.Left="212"
                                            Canvas.Top="77"
                                            Width="94"
                                            Height="32"
                                            Style="{StaticResource EdlSecondaryButtonStyle}"
                                            Click="EdlBugFeedbackButton_Click" VerticalAlignment="Top" Background="#FFFFA3A3" Foreground="White" BorderBrush="#FFDFDFE0"/>
                                        </Canvas>
                                    </Viewbox>
                                </GroupBox>
                            </Grid>

                            <!-- Left Column: Configuration, Partitions, Console -->
                            <Grid Grid.Column="0" Grid.Row="0">

                                <!-- Partition Table & Inputs -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="130" />
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- File Selection GroupBox -->
                                    <GroupBox
                                    Grid.Row="0"
                                    Header="文件选择"
                                    Style="{StaticResource EdlCardGroupBoxStyle}"
                                    Margin="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="84"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Text="引导文件" Style="{StaticResource EdlFieldLabelStyle}"/>
                                            <TextBox x:Name="EdlLoaderTextBox"
                                                     Grid.Row="0"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource EdlTextBoxStyle}" Grid.ColumnSpan="2" Margin="54,0,0,0"/>
                                            <Button x:Name="EdlLoaderBrowseButton"
                                                    Grid.Row="0"
                                                    Grid.Column="3"
                                                    Width="84"
                                                    Style="{StaticResource EdlPrimaryButtonStyle}"
                                                    BorderBrush="#FFE6E6E6"
                                                    Background="SkyBlue"
                                                    Click="EdlLoaderBrowseButton_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <svg:SvgViewbox Source="images/文件夹.svg" Width="16" Height="16" Margin="0,0,5,0"/>
                                                    <TextBlock Text="选择" VerticalAlignment="Center" Foreground="White"/>
                                                </StackPanel>
                                            </Button>

                                            <TextBlock Grid.Row="2" Text="刷写文件" Style="{StaticResource EdlFieldLabelStyle}"/>
                                            <TextBox x:Name="EdlFlashPackTextBox"
                                                     Grid.Row="2"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource EdlTextBoxStyle}" Grid.ColumnSpan="2" Margin="54,0,0,0"/>
                                            <Button x:Name="EdlFlashPackBrowseButton"
                                                    Grid.Row="2"
                                                    Grid.Column="3"
                                                    Width="84"
                                                    Style="{StaticResource EdlPrimaryButtonStyle}"
                                                    BorderBrush="#FFE6E6E6"
                                                    Background="SkyBlue"
                                                    Click="EdlFlashPackBrowseButton_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <svg:SvgViewbox Source="images/文件夹.svg" Width="16" Height="16" Margin="0,0,5,0"/>
                                                    <TextBlock Text="选择" VerticalAlignment="Center" Foreground="White"/>
                                                </StackPanel>
                                            </Button>

                                            <TextBlock Grid.Row="4" Text="云端引导" Style="{StaticResource EdlFieldLabelStyle}"/>
                                            <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="EdlBuiltInLoaderComboBox"
                                                          Grid.Column="0"
                                                          Style="{StaticResource EdlComboBoxStyle}"
                                                          Text="加载云端引导..."
                                                          IsEditable="True"
                                                          IsReadOnly="True"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectionChanged="EdlBuiltInLoaderComboBox_SelectionChanged" Margin="-9,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="存储器" Style="{StaticResource EdlFieldLabelStyle}"/>
                                                <ComboBox Grid.Column="4"
                                                          Style="{StaticResource EdlComboBoxStyle}"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="UFS"/>
                                                    <ComboBoxItem Content="EMMC"/>
                                                </ComboBox>
                                                <TextBlock Grid.Column="6" Text="串口" Style="{StaticResource EdlFieldLabelStyle}"/>
                                                <ComboBox x:Name="EdlPortComboBox"
                                                          Grid.Column="8"
                                                          Style="{StaticResource EdlComboBoxStyle}"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="False"
                                                          StaysOpenOnEdit="True"
                                                          DropDownOpened="EdlPortComboBox_DropDownOpened"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <!-- Select All -->
                                    <CheckBox
                                    x:Name="EdlPartSelectAllCheckBox"
                                    Content="全选"
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,5"
                                    Visibility="Collapsed"
                                    Click="EdlPartSelectAllCheckBox_Click" />

                                    <!-- Partition Table GroupBox -->
                                    <GroupBox
                                    Grid.Row="2"
                                    Header="分区表"
                                    Style="{StaticResource EdlCardGroupBoxStyle}"
                                    Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid x:Name="EdlPartitionContentGrid"
                                                  Grid.RowSpan="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                    Height="28"
                                                    Background="#FFFFFFFF"
                                                    BorderBrush="#FFDDE2EA"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Margin="0,0,0,8">
                                                    <DockPanel LastChildFill="True">
                                                        <ComboBox
                                                        x:Name="EdlPartitionSearchComboBox"
                                                        Height="28"
                                                        Margin="0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Foreground="#FF334155"
                                                        FontFamily="Microsoft YaHei UI"
                                                        FontSize="12"
                                                        VerticalContentAlignment="Center"
                                                        IsEditable="True"
                                                        IsTextSearchEnabled="False"
                                                        StaysOpenOnEdit="True"
                                                        TextSearch.TextPath="PartitionName"
                                                        DisplayMemberPath="PartitionName"
                                                        SelectionChanged="EdlPartitionSearchComboBox_SelectionChanged"
                                                        DropDownOpened="EdlPartitionSearchComboBox_DropDownOpened"
                                                        PreviewTextInput="EdlPartitionSearchComboBox_PreviewTextInput"
                                                        KeyUp="EdlPartitionSearchComboBox_KeyUp"/>
                                                    </DockPanel>
                                                </Border>

                                                <DataGrid
                                            x:Name="EdlPartitionDataGrid"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            IsReadOnly="False"
                                            HeadersVisibility="Column"
                                            SelectionMode="Extended"
                                            SelectionUnit="FullRow"
                                            AlternationCount="2"
                                            FontSize="12"
                                            FontFamily="Microsoft YaHei UI"
                                            Foreground="#FF334155"
                                            Background="#FFFFFFFF"
                                            BorderBrush="#FFE7E9EF"
                                            BorderThickness="1"
                                            GridLinesVisibility="None"
                                            RowHeight="29"
                                            ColumnHeaderHeight="32"
                                            Grid.Row="1"
                                            Margin="0"
                                              MouseDoubleClick="EdlPartitionDataGrid_MouseDoubleClick">
                                                    <DataGrid.Resources>
                                                        <Style x:Key="EdlPartitionTextStyle" TargetType="{x:Type TextBlock}">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        </Style>
                                                        <Style x:Key="EdlPartitionCellStyle" TargetType="{x:Type DataGridCell}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground"
                                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground"
                                                                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.Resources>
                                                    <DataGrid.CellStyle>
                                                        <StaticResource ResourceKey="EdlPartitionCellStyle"/>
                                                    </DataGrid.CellStyle>
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="{x:Type DataGridRow}">
                                                            <Setter Property="Background" Value="#FFFFFFFF"/>
                                                            <Setter Property="Foreground" Value="#FF334155"/>
                                                            <Setter Property="BorderBrush" Value="#FFF0F1F5"/>
                                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="AlternationIndex" Value="1">
                                                                    <Setter Property="Background" Value="#FFFCFBFD"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FFF6F1FF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#FF87CEEB"/>
                                                                    <Setter Property="Foreground" Value="#FF263142"/>
                                                                    <Setter Property="BorderBrush" Value="#FF6BBFE3"/>
                                                                </Trigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=EdlSkipSafeCheckBox, Path=IsChecked}" Value="True"/>
                                                                        <Condition Binding="{Binding IsBasebandPartition}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="#FFF2D7FF"/>
                                                                    <Setter Property="Foreground" Value="#FF475569"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="BorderBrush" Value="#FFE2BFF3"/>
                                                                    <Setter Property="Cursor" Value="No"/>
                                                                    <Setter Property="ToolTip" Value="该分区已受基带指纹保护，当前禁止写入"/>
                                                                    <Setter Property="ToolTipService.ShowDuration" Value="6000"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=EdlSkipSafeCheckBox, Path=IsChecked}" Value="True"/>
                                                                        <Condition Binding="{Binding IsBasebandPartition}" Value="True"/>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="#FFF2D7FF"/>
                                                                    <Setter Property="Foreground" Value="#FF475569"/>
                                                                    <Setter Property="BorderBrush" Value="#FFE2BFF3"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=EdlSkipDataCheckBox, Path=IsChecked}" Value="True"/>
                                                                        <Condition Binding="{Binding IsDataPartition}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="#FFF2D7FF"/>
                                                                    <Setter Property="Foreground" Value="#FF475569"/>
                                                                    <Setter Property="BorderBrush" Value="#FFE2BFF3"/>
                                                                    <Setter Property="Cursor" Value="No"/>
                                                                    <Setter Property="ToolTip" Value="该数据分区已受保护，当前禁止写入"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Width="32">
                                                            <DataGridTemplateColumn.CellStyle>
                                                                <Style TargetType="{x:Type DataGridCell}"
                                                                   BasedOn="{StaticResource EdlPartitionCellStyle}">
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                </Style>
                                                            </DataGridTemplateColumn.CellStyle>
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Grid Width="18" Height="18">
                                                                        <CheckBox
                                                                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="16"
                                                                        Height="16"
                                                                        Margin="0"
                                                                        Padding="0"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                            <CheckBox.Style>
                                                                                <Style TargetType="{x:Type CheckBox}"
                                                                                   BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding ElementName=EdlSkipSafeCheckBox, Path=IsChecked}" Value="True"/>
                                                                                                <Condition Binding="{Binding IsBasebandPartition}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                                        </MultiDataTrigger>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding ElementName=EdlSkipDataCheckBox, Path=IsChecked}" Value="True"/>
                                                                                                <Condition Binding="{Binding IsDataPartition}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </CheckBox.Style>
                                                                        </CheckBox>
                                                                        <svg:SvgViewbox
                                                                        Source="images/盾牌.svg"
                                                                        Width="16"
                                                                        Height="16"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="该分区已受基带指纹保护，当前禁止写入">
                                                                            <svg:SvgViewbox.Style>
                                                                                <Style TargetType="{x:Type svg:SvgViewbox}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding ElementName=EdlSkipSafeCheckBox, Path=IsChecked}" Value="True"/>
                                                                                                <Condition Binding="{Binding IsBasebandPartition}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </svg:SvgViewbox.Style>
                                                                        </svg:SvgViewbox>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                            <DataGridTemplateColumn.HeaderStyle>
                                                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                    <Setter Property="Background" Value="#FFF5F3F8"/>
                                                                </Style>
                                                            </DataGridTemplateColumn.HeaderStyle>
                                                            <DataGridTemplateColumn.Header>
                                                                <CheckBox x:Name="EdlSelectAllCheckBox"
                                                              IsThreeState="True"
                                                              Width="16"
                                                              Height="16"
                                                              Margin="0"
                                                              Padding="0"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Click="EdlToggleSelectAllCheckBox_Click"/>
                                                            </DataGridTemplateColumn.Header>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Binding="{Binding Label}" Header="名称" Width="1.35*" MinWidth="54" IsReadOnly="True" ElementStyle="{StaticResource EdlPartitionTextStyle}"/>
                                                        <DataGridTextColumn Binding="{Binding Lun}" Header="LUN" Width="40" IsReadOnly="True" ElementStyle="{StaticResource EdlPartitionTextStyle}"/>
                                                        <DataGridTextColumn Binding="{Binding StartSector}" Header="起始扇区" Width="1.05*" MinWidth="54" IsReadOnly="True" ElementStyle="{StaticResource EdlPartitionTextStyle}"/>
                                                        <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="分区大小" Width="0.9*" MinWidth="50" IsReadOnly="True" ElementStyle="{StaticResource EdlPartitionTextStyle}"/>
                                                        <DataGridTemplateColumn Header="路径" Width="1.5*" MinWidth="60" IsReadOnly="True">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <TextBlock VerticalAlignment="Center"
                                                                               HorizontalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding FilePath}"
                                                                               Margin="5,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding FileName}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding FileName}" Value="">
                                                                                            <Setter Property="Text" Value="双击选择文件路径"/>
                                                                                            <Setter Property="Foreground" Value="#FF94A3B8"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding FileName}" Value="{x:Null}">
                                                                                            <Setter Property="Text" Value="双击选择文件路径"/>
                                                                                            <Setter Property="Foreground" Value="#FF94A3B8"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>

                                            <Border x:Name="EdlStopOperationOverlay"
                                                    Grid.RowSpan="2"
                                                    Panel.ZIndex="20"
                                                    Visibility="Collapsed"
                                                    Background="#B8FFFFFF"
                                                    BorderBrush="#66D8DEE8"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <hc:LoadingCircle IsRunning="True"
                                                                      Width="84"
                                                                      Height="84"
                                                                      DotSpeed="2.6"
                                                                      DotDiameter="7"
                                                                      Foreground="#0078D7"
                                                                      Margin="0,0,0,12"/>
                                                    <TextBlock x:Name="EdlOperationOverlayText"
                                                               Text="操作正在进行中，请勿断开数据线..."
                                                               Margin="0,0,0,14"
                                                               HorizontalAlignment="Center"
                                                               FontFamily="Microsoft YaHei UI"
                                                               FontSize="11.5"
                                                               Foreground="#FF64748B"/>
                                                    <Button x:Name="EdlStopOperationButton"
                                                            Content="停止操作"
                                                            Width="96"
                                                            Height="30"
                                                            Style="{StaticResource EdlStopButtonStyle}"
                                                            Click="EdlStopOperationButton_Click"
                                                            ToolTip="等待当前分区完成后停止后续操作"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </GroupBox>
                                </Grid>

                            </Grid>

                            <!-- Operation Console -->
                            <Viewbox Grid.Row="2"
                                     Grid.Column="0"
                                     Margin="0,8,0,0"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center">
                                <Canvas x:Name="EdlOperationButtonsCanvas"
                                    Width="520"
                                    Height="40">
                                    <Button x:Name="EdlReadGptButton"
                                        Canvas.Left="0"
                                        Canvas.Top="4"
                                        Content="读分区表"
                                        Width="98"
                                        Height="32"
                                        Style="{StaticResource EdlSecondaryButtonStyle}"
                                        Click="EdlReadGptButton_Click"
                                        PreviewMouseLeftButtonDown="EdlDraggableButton_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="EdlDraggableButton_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="EdlDraggableButton_PreviewMouseLeftButtonUp" VerticalAlignment="Top"/>
                                    <Button x:Name="EdlReadPartButton"
                                        Canvas.Left="103"
                                        Canvas.Top="5"
                                        Content="回读分区"
                                        Width="98"
                                        Height="32"
                                        Style="{StaticResource EdlSecondaryButtonStyle}"
                                        Click="EdlReadPartButton_Click"
                                        PreviewMouseLeftButtonDown="EdlDraggableButton_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="EdlDraggableButton_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="EdlDraggableButton_PreviewMouseLeftButtonUp" VerticalAlignment="Top"/>
                                    <Button x:Name="EdlWritePartButton"
                                        Canvas.Left="206"
                                        Canvas.Top="5"
                                        Content="写入分区"
                                        Width="98"
                                        Height="32"
                                        Style="{StaticResource EdlPrimaryButtonStyle}"
                                        Click="EdlWritePartButton_Click"
                                        PreviewMouseLeftButtonDown="EdlDraggableButton_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="EdlDraggableButton_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="EdlDraggableButton_PreviewMouseLeftButtonUp" VerticalAlignment="Top" Background="White" BorderBrush="#FFD8DEE8" Foreground="#FF475569"/>
                                    <Button x:Name="EdlErasePartButton"
                                        Canvas.Left="311"
                                        Canvas.Top="5"
                                        Content="擦除分区"
                                        Width="98"
                                        Height="32"
                                        Style="{StaticResource EdlDangerButtonStyle}"
                                        Click="EdlErasePartButton_Click"
                                        PreviewMouseLeftButtonDown="EdlDraggableButton_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="EdlDraggableButton_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="EdlDraggableButton_PreviewMouseLeftButtonUp" VerticalAlignment="Top" BorderBrush="#FFD8DEE8" Foreground="#FF475569"/>
                                    <ComboBox x:Name="EdlResetComboBox"
                                          Canvas.Left="415"
                                          Canvas.Top="5"
                                          Width="108"
                                          Height="32"
                                          Style="{StaticResource EdlComboBoxStyle}"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="EdlResetComboBox_SelectionChanged"
                                          IsEditable="True"
                                          IsReadOnly="True"
                                          SelectedIndex="-1"
                                          Text="EDL重启" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <ComboBoxItem Content="重启到系统"/>
                                        <ComboBoxItem Content="重启到EDL"/>
                                        <ComboBoxItem Content="重启到Recovery"/>
                                        <ComboBoxItem Content="重启到FastbootD"/>
                                    </ComboBox>
                                </Canvas>
                            </Viewbox>

                            <Grid
                                Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ProgressBar
                                    x:Name="EdlProgressBar"
                                    Grid.Row="0"
                                    Height="24"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    Tag="0.00 B/s"
                                    Background="#FFF1F3F7"
                                    BorderBrush="#FFDCE1E8"
                                    BorderThickness="1"
                                    Margin="0">
                                    <ProgressBar.Style>
                                        <Style TargetType="{x:Type ProgressBar}">
                                            <Setter Property="SnapsToDevicePixels" Value="True" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                                                        <Border
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                            <Grid ClipToBounds="True">
                                                                <Border
                                                                    x:Name="PART_Track"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="4" />
                                                                <Border
                                                                    x:Name="PART_Indicator"
                                                                    HorizontalAlignment="Left"
                                                                    CornerRadius="4">
                                                                    <Border.Width>
                                                                        <MultiBinding Converter="{StaticResource ProgressBarIndicatorWidthConverter}">
                                                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                                                        </MultiBinding>
                                                                    </Border.Width>
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Offset="0" Color="#FF87CEEB" />
                                                                            <GradientStop Offset="1" Color="#FF4A90E2" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <TextBlock
                                                                    Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Margin="8,0,0,0"
                                                                    FontSize="12"
                                                                    Foreground="#FF333333"
                                                                    FontWeight="Medium"
                                                                    IsHitTestVisible="False" />
                                                                <TextBlock
                                                                    Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.00}%}"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,8,0"
                                                                    FontSize="12"
                                                                    Foreground="#FF333333"
                                                                    FontWeight="Medium"
                                                                    IsHitTestVisible="False" />
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock
                                    x:Name="EdlProgressTextBlock"
                                    Grid.Row="1"
                                    Margin="8,6,8,0"
                                    FontSize="12"
                                    Foreground="#FF64748B"
                                    MaxWidth="520"
                                    TextTrimming="CharacterEllipsis"
                                    Text=""
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,8,0,0">
                                <Viewbox Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="EdlAutoRebootCheckBox"
                                              Content="自动重启"
                                              Style="{StaticResource EdlOptionCheckBoxStyle}"/>
                                        <CheckBox x:Name="EdlFactoryResetCheckBox"
                                              Content="自动格式化"
                                              Checked="EdlFactoryResetCheckBox_Checked_Edl"
                                              Unchecked="EdlFactoryResetCheckBox_Unchecked_Edl"
                                              Style="{StaticResource EdlOptionCheckBoxStyle}"/>
                                        <CheckBox x:Name="EdlSendLoaderCheckBox"
                                              Content="发送引导"
                                              IsChecked="True"
                                              Style="{StaticResource EdlOptionCheckBoxStyle}"/>
                                        <CheckBox x:Name="EdlSkipSafeCheckBox"
                                              Content="保护基带指纹"
                                              IsChecked="True"
                                              Checked="EdlSkipSafeCheckBox_Checked"
                                              Unchecked="EdlSkipSafeCheckBox_Unchecked"
                                              Style="{StaticResource EdlOptionCheckBoxStyle}"/>
                                        <CheckBox x:Name="EdlSkipDataCheckBox"
                                              Content="保护数据"
                                              IsChecked="False"
                                              Checked="EdlSkipDataCheckBox_Checked_Edl"
                                              Unchecked="EdlSkipDataCheckBox_Unchecked_Edl"
                                              Style="{StaticResource EdlOptionCheckBoxStyle}"/>
                                        <CheckBox x:Name="EdlGenerateProgramCheckBox"
                                              Content="生成XML"
                                              IsChecked="True"
                                              Style="{StaticResource EdlOptionCheckBoxStyle}"
                                              Margin="0"/>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                        </Grid>
                        <Grid
                        Name="AppManagementView"
                        Visibility="Collapsed"
                        Background="White"
                        Margin="0,-4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="255"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0"
                                      Header="应用列表"
                                      Style="{StaticResource PayloadGroupBoxStyle}"
                                      FontSize="12"
                                      BorderBrush="#FFE0E0E0" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            Background="#FFF9F5FC"
                                            BorderBrush="#FFE8D8F2"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock
                                                           VerticalAlignment="Center"
                                                           Foreground="#FF444444"><Run Text="仅"/><Run Language="zh-cn" Text="显示"/><Run Text="用户应用"/></TextBlock>
                                                <ToggleButton x:Name="AppListSwitchToggle"
                                                              Style="{StaticResource SwitchToggleButtonStyle}"
                                                              Checked="AppListThirdPartyToggle_Checked"
                                                              IsChecked="True"
                                                              Margin="8,0,18,0"/>
                                                <TextBlock Text="仅看系统应用"
                                                           VerticalAlignment="Center"
                                                           Foreground="#FF444444"/>
                                                <ToggleButton x:Name="AppListSwitchToggle复制__C_"
                                                              Style="{StaticResource SwitchToggleButtonStyle}"
                                                              Checked="AppListSystemToggle_Checked"
                                                              Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="包名搜索"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#FF444444"/>
                                                <TextBox x:Name="AppPackageSearchComboBox"
                                                         Grid.Column="1"
                                                         Style="{StaticResource AppFilterTextBoxStyle}"
                                                         KeyUp="AppPackageSearchComboBox_KeyUp"/>
                                                <Button x:Name="CopySelectedPackagesButton"
                                                        Grid.Column="2"
                                                        Width="98"
                                                        Margin="10,0,0,0"
                                                        Style="{StaticResource AppActionButtonStyle}"
                                                        Click="CopySelectedPackagesButton_Click"
                                                        Content="复制包名"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Text="支持多选应用后进行卸载、冻结、提取 APK 等批量操作。"
                                               Margin="0,0,0,8"
                                               Foreground="#FF7A7A7A"
                                               FontSize="11"/>

                                    <DataGrid Grid.Row="2"
                                              Name="AppListDataGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False"
                                              HeadersVisibility="Column"
                                              SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                              FontSize="12"
                                              Background="#FFF6EFF8"
                                              BorderThickness="0"
                                              RowHeight="30"
                                              GridLinesVisibility="Horizontal"
                                              AlternatingRowBackground="#FFFCFAFE">
                                        <DataGrid.Resources>
                                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                                <Setter Property="Background" Value="#FFF1E6F7"/>
                                                <Setter Property="Foreground" Value="#FF4A4050"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="10,0"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Height" Value="32"/>
                                            </Style>
                                            <Style TargetType="{x:Type DataGridCell}">
                                                <Setter Property="Padding" Value="10,0"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Width="42"
                                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGridCheckBoxColumn.CellStyle>
                                                    <Style TargetType="{x:Type DataGridCell}">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </Style>
                                                </DataGridCheckBoxColumn.CellStyle>
                                                <DataGridCheckBoxColumn.ElementStyle>
                                                    <Style TargetType="{x:Type CheckBox}">
                                                        <Setter Property="Width" Value="16"/>
                                                        <Setter Property="Height" Value="16"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridCheckBoxColumn.ElementStyle>
                                                <DataGridCheckBoxColumn.EditingElementStyle>
                                                    <Style TargetType="{x:Type CheckBox}">
                                                        <Setter Property="Width" Value="16"/>
                                                        <Setter Property="Height" Value="16"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridCheckBoxColumn.EditingElementStyle>
                                                <DataGridCheckBoxColumn.HeaderStyle>
                                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                        <Setter Property="Background" Value="#FFF1E6F7"/>
                                                    </Style>
                                                </DataGridCheckBoxColumn.HeaderStyle>
                                                <DataGridCheckBoxColumn.Header>
                                                    <CheckBox x:Name="SelectAllAppPackagesCheckBox"
                                                              IsThreeState="True"
                                                              Width="16"
                                                              Height="16"
                                                              Margin="0"
                                                              Padding="0"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Checked="SelectAllAppPackagesCheckBox_Checked"
                                                              Unchecked="SelectAllAppPackagesCheckBox_Unchecked"/>
                                                </DataGridCheckBoxColumn.Header>
                                            </DataGridCheckBoxColumn>
                                            <DataGridTextColumn Header="软件名称"
                                                                Binding="{Binding AppName}"
                                                                IsReadOnly="True"
                                                                Width="2.1*"/>
                                            <DataGridTextColumn Header="版本"
                                                                Binding="{Binding Version}"
                                                                IsReadOnly="True"
                                                                Width="1.1*"/>
                                            <DataGridTextColumn Header="包名"
                                                                Binding="{Binding PackageName}"
                                                                IsReadOnly="True"
                                                                Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <GroupBox Grid.Row="0"
                                          Header="快捷操作"
                                          Style="{StaticResource PayloadGroupBoxStyle}"
                                          FontSize="12"
                                          BorderBrush="#FFE0E0E0">
                                    <StackPanel>
                                        <Button x:Name="ReadAppListButton"
                                                Style="{StaticResource AppPrimaryActionButtonStyle}"
                                                Click="ReadAppListButton_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <svg:SvgViewbox Source="images/搜索.svg" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="读取应用列表" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ViewDisabledAppsButton"
                                                Style="{StaticResource AppActionButtonStyle}"
                                                Click="ViewDisabledAppsButton_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <svg:SvgViewbox Source="images/查看.svg" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="查看冻结应用" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <UniformGrid Columns="2" Margin="0,0,0,10">
                                            <Button x:Name="FreezeSelectedAppsButton"
                                                    Margin="0,0,6,0"
                                                    Style="{StaticResource AppActionButtonStyle}"
                                                    Click="FreezeSelectedAppsButton_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <svg:SvgViewbox Source="images/雪花.svg" Width="16" Height="16" Margin="0,0,6,0"/>
                                                    <TextBlock Text="冻结" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="UnfreezeSelectedAppsButton"
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource AppActionButtonStyle}"
                                                    Click="UnfreezeSelectedAppsButton_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <svg:SvgViewbox Source="images/解冻.svg" Width="16" Height="16" Margin="0,0,6,0"/>
                                                    <TextBlock Text="解冻" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                        <Button x:Name="ExtractApkButton"
                                                Style="{StaticResource AppActionButtonStyle}"
                                                Click="ExtractApkButton_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <svg:SvgViewbox Source="images/APK.svg" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="提取 APK 安装包" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <UniformGrid Columns="2" Margin="0,0,0,10">
                                            <Button x:Name="FreezeMiuiUpdaterButton"
                                                    Margin="0,0,6,0"
                                                    Style="{StaticResource AppActionButtonStyle}"
                                                    Click="FreezeMiuiUpdaterButton_Click"
                                                    ToolTip="目前仅支持小米">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <svg:SvgViewbox Source="images/雪花.svg" Width="16" Height="16" Margin="0,0,6,0"/>
                                                    <TextBlock Text="冻结更新" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="UnfreezeMiuiUpdaterButton"
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource AppActionButtonStyle}"
                                                    Click="UnfreezeMiuiUpdaterButton_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <svg:SvgViewbox Source="images/解冻.svg" Width="13" Height="16" Margin="0,0,6,0"/>
                                                    <TextBlock Text="恢复更新" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                        <Button x:Name="ClearAppDataButton"
                                                Style="{StaticResource AppActionButtonStyle}"
                                                Click="ClearAppDataButton_Click"
                                                Content="清除应用数据"/>
                                        <Button x:Name="UninstallSelectedAppsButton"
                                                Style="{StaticResource AppDangerActionButtonStyle}"
                                                Click="UninstallSelectedAppsButton_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <svg:SvgViewbox Source="images/卸载.svg" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="卸载选中应用" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Row="1"
                                          Header="运行日志"
                                          Margin="0,12,0,10"
                                          Style="{StaticResource PayloadGroupBoxStyle}"
                                          FontSize="12"
                                          BorderBrush="#FFE0E0E0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="1"
                                                Background="#FFF9F5FC"
                                                BorderBrush="#FFE8D8F2"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <TextBox x:Name="AppManagementLogTextBox"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="Transparent"
                                                     Foreground="#FF4A4050"
                                                     BorderThickness="0"
                                                     Padding="10"
                                                     FontFamily="Segoe UI"/>
                                        </Border>
                                    </Grid>
                                </GroupBox>
                            </Grid>
            </Grid>
        </Grid>
        </Grid>

        <!-- 底部状态栏 (原生 Win32 简约扁平风格，置于安全区内底部) -->
        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Height="26"
                Background="#EAEAEA"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="2">
            <Grid>
                <!-- 左侧连接状态 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Ellipse Name="BottomConnectionStatusIndicator"
                             Width="8"
                             Height="8"
                             Margin="0,0,6,0"
                             Fill="#10B981"
                             Stroke="#D1FAE5"
                             StrokeThickness="1"
                             Visibility="Collapsed"/>
                    <TextBlock Name="BottomConnectionTypeText"
                               Text="--"
                               FontSize="12"
                               Foreground="#555555"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧功能按钮：CMD命令行与设备管理器 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Name="CmdButton"
                            Content="CMD命令行"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#444444"
                            FontSize="12"
                            Cursor="Hand"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            Click="CmdButton_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E2E5EA"/>
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Name="DeviceManagerButton"
                            Content="设备管理器"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#444444"
                            FontSize="12"
                            Cursor="Hand"
                            Padding="8,2"
                            Click="DeviceManagerButton_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E2E5EA"/>
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>

        <!-- 启动时的初始化遮罩层 -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Panel.ZIndex="999" Visibility="Collapsed" Background="#C0FFFFFF"/>
        <Grid x:Name="LoadingContent" Grid.RowSpan="2" Panel.ZIndex="1000" Visibility="Collapsed" Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="正在初始化程序环境..." FontSize="16" FontWeight="SemiBold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <hc:LoadingCircle IsRunning="True" DotSpeed="3" DotDiameter="8" Foreground="#0078D4" Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
