<Window
    x:Class="SmartTool.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:SmartTool"
    xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
    mc:Ignorable="d"
    Title="Yuzaki工具箱 - 无线调试"
    Height="340"
    Width="560"
    WindowStartupLocation="CenterScreen"
    Background="#F5F6F8"
    ResizeMode="NoResize"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
        <Grid Margin="20,15,20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 表单输入区域 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DCE0E6" BorderThickness="1" CornerRadius="8" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="网络调试端口：" VerticalAlignment="Center" FontSize="13" Foreground="#333333" FontWeight="SemiBold"/>
                <TextBox x:Name="PortTextBox" Grid.Row="0" Grid.Column="1" Text="5555" Height="30" VerticalContentAlignment="Center" Padding="6,0" FontSize="13" BorderBrush="#DCE0E6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="WiFi IPV4地址：" VerticalAlignment="Center" FontSize="13" Foreground="#333333" FontWeight="SemiBold"/>
                <TextBox x:Name="IpTextBox" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Padding="6,0" FontSize="13" BorderBrush="#DCE0E6"/>

                <Button x:Name="WiredToWirelessButton" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Click="WiredToWirelessButton_Click"
                        Content="有线转无线连接" Margin="14,0,0,0" Width="130" Height="72"
                        Background="#0078D4" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#106EBE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- 说明提示区域 -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="#F0F2F5" BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#666666" LineHeight="20">
                1. 使用此功能前请确保手机与电脑连接至同一个局域网 WiFi。&#x0a;
                2. 手机上请先开启“开发者选项”及“USB调试”功能。&#x0a;
                3. 第一次使用需使用数据线连接手机，确保工具已识别到设备。&#x0a;
                4. 网络调试端口默认填 5555 即可，IP地址请在手机的“WLAN设置详情”中查看。
            </TextBlock>
        </Border>
    </Grid>
</Window>
