<Window
	x:Class="WpfApp1.MainWindow" 
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:local="clr-namespace:WpfApp1"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
	xmlns:test1="clr-namespace:test1"
	Title="Yuzaki工具箱"
	Width="1024"
	Height="768"
	MinWidth="1024"
	MaxWidth="1024"
	MinHeight="768"
	MaxHeight="768"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen"
	Background="#F0F0F0"
	Closing="MainWindow_Closing"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	TextOptions.TextFormattingMode="Display"
	TextOptions.TextRenderingMode="ClearType"
	RenderOptions.BitmapScalingMode="HighQuality"
	mc:Ignorable="d">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <DropShadowEffect
                Color="Black"
                Direction="315"
                ShadowDepth="5"
                Opacity="0.3"
                BlurRadius="10"
                x:Key="DropShadowEffect" />
            <LinearGradientBrush x:Key="StorageGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#9AD7FF" Offset="0"/>
                <GradientStop Color="#6EBBFF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="MemoryGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#D6B3FF" Offset="0"/>
                <GradientStop Color="#B88CFF" Offset="1"/>
            </LinearGradientBrush>
            <Style x:Key="FastbootButtonBaseStyle" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="#E1E1E1"/>
                <Setter Property="Foreground" Value="#000000"/>
                <Setter Property="BorderBrush" Value="#ADADAD"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#E5F1FB"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078D7"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#CCE4F7"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#005499"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#F4F4F4"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CCCCCC"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FastbootPrimaryButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource FastbootButtonBaseStyle}">
                <Setter Property="Background" Value="#0078D7"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#0063B1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#198AE3"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0063B1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#005A9E"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#004578"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#A6D2F5"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A6D2F5"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AnimatedHoverButtonStyle" TargetType="Button" BasedOn="{StaticResource FastbootButtonBaseStyle}">
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <local:EqualsToParameterConverter x:Key="EqualsConverter" />
            <local:ProgressBarIndicatorWidthConverter x:Key="ProgressBarIndicatorWidthConverter" />
            <Style x:Key="Win32RectProgressBarStyle" TargetType="{x:Type ProgressBar}">
                <Setter Property="Height" Value="10"/>
                <Setter Property="Background" Value="#EAEFF5"/>
                <Setter Property="BorderBrush" Value="#D5DDE5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#0078D7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2"/>
                                <Rectangle x:Name="PART_Track" Margin="1"/>
                                <Decorator x:Name="PART_Indicator" Margin="1" HorizontalAlignment="Left">
                                    <Border Background="{TemplateBinding Foreground}" CornerRadius="1"/>
                                </Decorator>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#F5F5F5" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="10,0,0,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0" Width="3" Background="#0078D7" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Border x:Name="MainBd" Grid.Column="1" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBd" Property="Background" Value="#E5F1FB" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="MainBd" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PayloadGroupBoxStyle" TargetType="{x:Type GroupBox}">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#222222"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupBox}">
                            <Grid>
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </Border>
                                <Border
                                    Background="{TemplateBinding Background}"
                                    Margin="10,-8,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <ContentPresenter
                                        ContentSource="Header"
                                        TextElement.Foreground="{TemplateBinding Foreground}"
                                        TextElement.FontSize="{TemplateBinding FontSize}"
                                        TextElement.FontWeight="{TemplateBinding FontWeight}"
                                        Margin="4,0" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SwitchToggleButtonStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="PART_Border" 
                                    Width="36" 
                                    Height="18" 
                                    Background="#B0B0B0" 
                                    CornerRadius="9">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PART_Ellipse" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                                 To="18" 
                                                                 Duration="00:00:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PART_Ellipse" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                                 To="0" 
                                                                 Duration="00:00:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Ellipse x:Name="PART_Ellipse" Width="14" Height="14" 
                                         Margin="2,0" 
                                         VerticalAlignment="Center" HorizontalAlignment="Left" 
                                         Fill="White">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" TargetName="PART_Border" 
                                            Value="#0078D7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AppActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FastbootButtonBaseStyle}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Padding" Value="10,0"/>
            </Style>
            <Style x:Key="AppPrimaryActionButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource FastbootPrimaryButtonStyle}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="AppDangerActionButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource FastbootButtonBaseStyle}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Background" Value="#D83B01"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#B71C1C"/>
            </Style>
            <Style x:Key="AppFilterTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#7A7A7A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="TextBoxBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="1">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#0078D7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid Background="#F0F0F0">
        <!-- 20px 安全区容器：四周保留20px不可显示内容的纯净安全区 -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- 主工作区域 -->
                <RowDefinition Height="*"/>
                <!-- 底部状态栏 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 主工作区域：左侧导航栏(200px) + 间距(20px) + 右侧页面区(*) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- 导航栏：200px 靠左显示 -->
                    <ColumnDefinition Width="200"/>
                    <!-- 页面区和导航栏之间的距离：20px -->
                    <ColumnDefinition Width="20"/>
                    <!-- 右侧页面区 -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航侧边栏 (200px 靠左显示，默认Win32简约扁平风格) -->
                <Border Grid.Column="0"
                        Background="#F5F5F5"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="SideMenuScrollViewer_PreviewMouseWheel">
                        <hc:SideMenu ExpandMode="Freedom"
                                     Background="Transparent"
                                     Margin="4,8,4,8"
                                     FontFamily="Microsoft YaHei UI"
                                     FontSize="13"
                                     SelectionChanged="SideMenu_SelectionChanged">
                            <hc:SideMenuItem
                                Name="HomeButton"
                                Header="主页"
                                Cursor="Hand" FontSize="13" PreviewMouseLeftButtonUp="DirectItem_PreviewMouseLeftButtonUp">
                                <hc:SideMenuItem.Icon>
                                    <svg:SvgViewbox Source="images/主页.svg" Width="16" Height="16"/>
                                </hc:SideMenuItem.Icon>
                            </hc:SideMenuItem>
                            <hc:SideMenuItem
                                Name="ScreenMirrorButton"
                                Header="投屏"
                                Cursor="Hand" FontSize="13" PreviewMouseLeftButtonUp="DirectItem_PreviewMouseLeftButtonUp">
                                <hc:SideMenuItem.Icon>
                                    <svg:SvgViewbox Source="images/投屏.svg" Width="16" Height="16"/>
                                </hc:SideMenuItem.Icon>
                            </hc:SideMenuItem>
                            <hc:SideMenuItem
                                Name="BasicFlashButton"
                                Header="基本刷入"
                                Cursor="Hand" PreviewMouseLeftButtonUp="DirectItem_PreviewMouseLeftButtonUp">
                                <hc:SideMenuItem.Icon>
                                    <svg:SvgViewbox Source="images/闪电.svg" Width="16" Height="16"/>
                                </hc:SideMenuItem.Icon>
                            </hc:SideMenuItem>
                            <hc:SideMenuItem
                                Name="EdlFlashButton"
                                Header="EDL刷写"
                                Cursor="Hand" PreviewMouseLeftButtonUp="DirectItem_PreviewMouseLeftButtonUp">
                                <hc:SideMenuItem.Icon>
                                    <svg:SvgViewbox Source="images/高通骁龙.svg" Width="16" Height="16"/>
                                </hc:SideMenuItem.Icon>
                            </hc:SideMenuItem>
                            <hc:SideMenuItem
                                Name="AppManagementButton"
                                Header="应用管理"
                                Cursor="Hand" PreviewMouseLeftButtonUp="DirectItem_PreviewMouseLeftButtonUp">
                                <hc:SideMenuItem.Icon>
                                    <svg:SvgViewbox Source="images/应用.svg" Width="16" Height="16"/>
                                </hc:SideMenuItem.Icon>
                            </hc:SideMenuItem>
                            <hc:SideMenuItem
                                Name="PayloadButton"
                                Header="Payload提取"
                                Cursor="Hand" PreviewMouseLeftButtonUp="DirectItem_PreviewMouseLeftButtonUp">
                                <hc:SideMenuItem.Icon>
                                    <svg:SvgViewbox Source="images/镜像文件.svg" Width="15" Height="18"/>
                                </hc:SideMenuItem.Icon>
                            </hc:SideMenuItem>
                        </hc:SideMenu>
                    </ScrollViewer>
                </Border>

                <!-- 右侧主要页面区域 (与导航栏距离为20px) -->
                <Grid Grid.Column="2">
<Grid
				Name="HomeView"
				Visibility="Collapsed">
                            <Grid.Resources>
                                <Style x:Key="HomeCardStyle" TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#D0D0D0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="2"/>
                                    <Setter Property="Padding" Value="12"/>
                                </Style>
                                <Style x:Key="HomePanelTitleStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#000000"/>
                                </Style>
                                <Style x:Key="HomePanelSubtitleStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="Margin" Value="0,2,0,0"/>
                                </Style>
                                <Style x:Key="HomeActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FastbootButtonBaseStyle}">
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                                <Style x:Key="HomeToolButtonStyle" TargetType="Button" BasedOn="{StaticResource FastbootButtonBaseStyle}">
                                    <Setter Property="Height" Value="28"/>
                                </Style>
                                <Style x:Key="HomeSwitchStyle" TargetType="{x:Type ToggleButton}">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border x:Name="PART_Border"
                                                        Width="36"
                                                        Height="18"
                                                        Background="#B0B0B0"
                                                        CornerRadius="9">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CheckStates">
                                                            <VisualState x:Name="Checked">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PART_Ellipse"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                     To="18"
                                                                                     Duration="00:00:0.15"/>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Unchecked">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PART_Ellipse"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                     To="0"
                                                                                     Duration="00:00:0.15"/>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Indeterminate" />
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <Ellipse x:Name="PART_Ellipse"
                                                             Width="14"
                                                             Height="14"
                                                             Margin="2,0"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Left"
                                                             Fill="White">
                                                        <Ellipse.RenderTransform>
                                                            <TranslateTransform/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" TargetName="PART_Border" Value="#0078D7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <!-- 页面区分为左右两个部分 2:1 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- 左侧为信息显示 (2*) -->
                                    <ColumnDefinition Width="2*"/>
                                    <!-- 中间间距 (20px) -->
                                    <ColumnDefinition Width="20"/>
                                    <!-- 右侧为功能区 (1*) -->
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：信息显示 (分为上下两个部分 间隔为20px) -->
                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- 上方：手机的信息显示 每行只显示一条信息 高度根据其内容决定 -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 间隔为20px -->
                                            <RowDefinition Height="20"/>
                                            <!-- 下方：电池内存储存显示 矩形条状显示 -->
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 上方：手机的信息显示 -->
                                        <Border Grid.Row="0" Style="{StaticResource HomeCardStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="设备信息"
                                                               Style="{StaticResource HomePanelTitleStyle}"
                                                               VerticalAlignment="Center"/>
                                                    <Button x:Name="HomeRefreshDeviceButton"
                                                            Content="刷新设备"
                                                            Click="RefreshDeviceButton_Click"
                                                            Height="24"
                                                            Padding="12,0"
                                                            HorizontalAlignment="Right"
                                                            Cursor="Hand"
                                                            Style="{StaticResource FastbootPrimaryButtonStyle}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- 每行只显示一条信息 高度根据其内容决定 -->
                                                <StackPanel>
                                                    <StackPanel.Resources>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="ToolTip" Value="单击复制"/>
                                                            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
                                                            <Setter Property="ToolTipService.ShowDuration" Value="2000"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <EventSetter Event="MouseLeftButtonDown" Handler="CopyTextBlockContent"/>
                                                        </Style>
                                                    </StackPanel.Resources>

                                                    <Grid Margin="0,1.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="设备状态:" FontWeight="SemiBold" Foreground="#555555" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="DeviceStatusText" Grid.Column="1" Text="检测中..." Foreground="#28A745" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>

                                                    <Grid Margin="0,1.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="连接类型:" FontWeight="SemiBold" Foreground="#555555" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="ConnectionTypeText" Grid.Column="1" Text="--" Foreground="#0078D7" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>

                                                    <Grid Margin="0,1.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="设备序列号:" FontWeight="SemiBold" Foreground="#555555" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="DeviceSerialText" Grid.Column="1" Text="--" Foreground="#FF5722" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>

                                                    <Grid Margin="0,1.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="*"/>
